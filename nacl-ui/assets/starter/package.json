{
  "name": "nacl-next-s3-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "NaCL Next S3 fixed Vue renderer over the typed JSON page contract",
  "scripts": {
    "validate": "node scripts/build-validators.mjs --check && node scripts/validate.mjs",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "build": "npm run validate && npm run typecheck && vite build",
    "desktop": "tauri build --no-bundle",
    "dev:mock": "npm run validate && vite --mode mock"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "vue": "3.5.40"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "@vitejs/plugin-vue": "5.2.4",
    "ajv": "8.20.0",
    "happy-dom": "21.0.4",
    "typescript": "5.6.3",
    "vite": "6.4.3",
    "vitest": "5.0.5",
    "vue-tsc": "3.3.8"
  }
}
