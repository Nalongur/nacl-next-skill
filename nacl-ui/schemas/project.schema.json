{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nacl-next.local/schema/project.schema.json",
  "title": "NaCL Next generated project configuration",
  "description": "One project config pins the mode, layout, adapter and SDK snapshot. It is generated; hand-editing requires re-running the validator and a rebuild.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "mode",
    "layout",
    "adapter",
    "pageSchemaVersion",
    "sdk",
    "template",
    "app"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "mode": {
      "enum": [
        "a",
        "b",
        "d"
      ]
    },
    "layout": {
      "enum": [
        "sidebar",
        "studio",
        "nacl"
      ]
    },
    "adapter": {
      "enum": [
        "ipc",
        "mock"
      ]
    },
    "pageSchemaVersion": {
      "type": "integer",
      "minimum": 1
    },
    "sdk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "const": "nacl-next-sdk"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "snapshotSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "git": {
          "type": "string"
        },
        "rev": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "contractsSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "oneOf": [
        {
          "required": [
            "snapshotSha256"
          ]
        },
        {
          "required": [
            "git",
            "rev",
            "contractsSha256"
          ]
        }
      ]
    },
    "template": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "layout",
        "mode"
      ],
      "properties": {
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "layout": {
          "enum": [
            "sidebar",
            "studio",
            "nacl"
          ]
        },
        "mode": {
          "enum": [
            "a",
            "b",
            "d"
          ]
        }
      }
    },
    "app": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "productName",
        "identifier",
        "window"
      ],
      "properties": {
        "productName": {
          "type": "string",
          "minLength": 3,
          "maxLength": 80
        },
        "identifier": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*(\\.[a-z0-9-]+){2,}$"
        },
        "window": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "width",
            "height",
            "minWidth",
            "minHeight"
          ],
          "properties": {
            "width": {
              "type": "integer",
              "minimum": 800,
              "maximum": 3840
            },
            "height": {
              "type": "integer",
              "minimum": 600,
              "maximum": 2160
            },
            "minWidth": {
              "type": "integer",
              "minimum": 760,
              "maximum": 1920
            },
            "minHeight": {
              "type": "integer",
              "minimum": 560,
              "maximum": 1200
            }
          }
        }
      }
    }
  }
}
